{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "install dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			]
		},
		{
			"label": "typecheck",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"typecheck"
			]
		},
		{
			"label": "typecheck2",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"typecheck"
			]
		},
		{
			"label": "typecheck3",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"typecheck"
			]
		},
		{
			"label": "lint",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint"
			]
		},
		{
			"label": "sync lockfile",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			]
		},
		{
			"label": "typecheck-final",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"typecheck"
			]
		},
		{
			"label": "lint-final",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint"
			]
		},
		{
			"label": "Deploy production (backup DB → push → Vercel)",
			"type": "process",
			"command": "bash",
			"args": [
				"${workspaceFolder}/scripts/deploy-production.sh",
				"${input:confirmProductionDeploy}"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true,
				"showReuseMessage": false
			},
			"problemMatcher": []
		},
		{
			"label": "Build frontend → push",
			"type": "process",
			"command": "bash",
			"args": [
				"${workspaceFolder}/scripts/build-frontend-push.sh"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true,
				"showReuseMessage": false
			},
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "confirmProductionDeploy",
			"type": "promptString",
			"description": "Nhập DEPLOY để xác nhận backup DB, git push và deploy production lên Vercel"
		}
	]
}
