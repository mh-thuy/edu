  refundMethod      TuitionPaymentMethod @map("refund_method")
  refundDate        DateTime?            @map("refund_date") @db.Timestamptz(6)
  bankTransactionNo String?              @map("bank_transaction_no") @db.VarChar(150)
  reason            String
  status            TuitionRefundStatus  @default(PENDING)
  createdBy         String               @map("created_by") @db.Uuid
  approvedBy        String?              @map("approved_by") @db.Uuid
  completedAt       DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment TuitionPayment @relation(fields: [paymentId], references: [id])

  @@index([paymentId], map: "idx_payment_refunds_payment_id")
