  balanceColumn         String?  @map("balance_column") @db.VarChar(100)
  isDefault             Boolean  @default(false) @map("is_default")
  isActive              Boolean  @default(true) @map("is_active")
  createdBy             String   @map("created_by") @db.Uuid
