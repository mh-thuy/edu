  dataStartRow          Int      @default(2) @map("data_start_row")
  dateFormat            String   @map("date_format") @db.VarChar(50)
  transactionDateColumn String   @map("transaction_date_column") @db.VarChar(100)
  valueDateColumn       String?  @map("value_date_column") @db.VarChar(100)
  transactionNoColumn   String?  @map("transaction_no_column") @db.VarChar(100)
  descriptionColumn     String   @map("description_column") @db.VarChar(100)
  senderNameColumn      String?  @map("sender_name_column") @db.VarChar(100)
  senderAccountColumn   String?  @map("sender_account_column") @db.VarChar(100)
  creditAmountColumn    String   @map("credit_amount_column") @db.VarChar(100)
