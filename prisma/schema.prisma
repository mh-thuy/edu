generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED

  @@map("user_status")
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE

  @@map("teacher_status")
}

enum StudentStatus {
  ACTIVE
  INACTIVE

  @@map("student_status")
}

enum ClassStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("class_status")
}

enum EnrollmentStatus {
  ACTIVE
  LEFT
  COMPLETED
  SUSPENDED

  @@map("enrollment_status")
}

enum ReceiptStatus {
  ACTIVE
  CANCELLED

  @@map("receipt_status")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  MAKEUP

  @@map("attendance_status")
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED

  @@map("payroll_status")
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED

  @@map("expense_status")
}

enum TuitionFeeStatus {
  UNPAID
  PAID
  OVERDUE
  EXEMPTED
  CANCELLED

  @@map("tuition_fee_status")
}

enum TuitionFeeItemType {
  TUITION
  MATERIAL
  UNIFORM
  EXAM_FEE
  OTHER_FEE
  DISCOUNT
  SCHOLARSHIP

  @@map("tuition_fee_item_type")
}

enum TuitionAdjustmentType {
  DISCOUNT
  SCHOLARSHIP
  ADD_FEE
  REDUCE_FEE
  EXEMPTION
  CANCELLATION
  TRANSFER_CLASS

  @@map("tuition_adjustment_type")
}

enum TuitionPaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER

  @@map("tuition_payment_method")
}

enum TuitionPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED

  @@map("tuition_payment_status")
}

enum PaymentBatchStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED

  @@map("payment_batch_status")
}

enum TuitionRefundStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED

  @@map("tuition_refund_status")
}

enum BankImportStatus {
  UPLOADED
  VALIDATING
  VALIDATED
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED

  @@map("bank_import_status")
}

enum BankReconciliationStatus {
  IMPORTED
  AUTO_MATCHED
  MANUAL_MATCHED
  CONFIRMED
  UNMATCHED
  AMBIGUOUS
  DUPLICATED
  AMOUNT_MISMATCH
  IGNORED
  REVERSED
  ERROR

  @@map("bank_reconciliation_status")
}

enum BankMatchMethod {
  TUITION_FEE_NO
  STUDENT_CODE
  PAYMENT_REFERENCE
  PHONE_NUMBER
  STUDENT_NAME
  PARENT_NAME
  AMOUNT
  MANUAL

  @@map("bank_match_method")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique(map: "uq_users_email") @db.VarChar(255)
  fullName     String     @map("full_name") @db.VarChar(255)
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  roles   UserRole[]
  teacher Teacher?

  @@map("users")
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique(map: "uq_roles_code") @db.VarChar(50)
  name        String  @db.VarChar(255)
  description String?
  isActive    Boolean @default(true) @map("is_active")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], map: "fk_user_roles_user")
  role Role @relation(fields: [roleId], references: [id], map: "fk_user_roles_role")

  @@unique([userId, roleId], map: "uq_user_roles_user_role")
  @@map("user_roles")
}

model Teacher {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String        @unique(map: "uq_teachers_code") @db.VarChar(50)
  userId      String?       @unique(map: "uq_teachers_user_id") @map("user_id") @db.Uuid
  fullName    String        @map("full_name") @db.VarChar(255)
  phone       String?       @db.VarChar(50)
  bankAccount String?       @map("bank_account") @db.VarChar(100)
  specialty   String?       @db.VarChar(255)
  status      TeacherStatus @default(ACTIVE)
  note        String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user      User?            @relation(fields: [userId], references: [id], map: "fk_teachers_user")
  classes   Class[]
  schedules ClassSchedule[]
  payrolls  TeacherPayroll[]

  @@map("teachers")
}

model Student {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String        @unique(map: "uq_students_code") @db.VarChar(50)
  fullName   String        @map("full_name") @db.VarChar(255)
  phone      String?       @db.VarChar(50)
  birthday   DateTime?     @db.Date
  parentName String?       @map("parent_name") @db.VarChar(255)
  address    String?
  status     StudentStatus @default(ACTIVE)
  note       String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  enrollments ClassStudent[]
  tuitionFees TuitionFee[]   @relation("TuitionFeeStudent")
  attendances Attendance[]
  paymentBatches PaymentBatch[]

  @@map("students")
}

model Class {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String      @unique(map: "uq_classes_code") @db.VarChar(50)
  name          String      @db.VarChar(255)
  teacherId     String?     @map("teacher_id") @db.Uuid
  tuitionFee    Decimal     @default(0) @map("tuition_fee") @db.Decimal(12, 2)
  totalSessions Int         @default(0) @map("total_sessions")
  startDate     DateTime?   @map("start_date") @db.Date
  endDate       DateTime?   @map("end_date") @db.Date
  status        ClassStatus @default(DRAFT)
  note          String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  teacher      Teacher?             @relation(fields: [teacherId], references: [id], map: "fk_classes_teacher")
  students     ClassStudent[]
  schedules    ClassSchedule[]
  attendances  Attendance[]
  tuitionFees  TuitionFee[]         @relation("TuitionFeeClass")
  salaryRule   ClassSalaryRule?
  payrollItems TeacherPayrollItem[]

  @@index([teacherId], map: "idx_classes_teacher_id")
  @@index([status], map: "idx_classes_status")
  @@map("classes")
}

model ClassStudent {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId    String           @map("class_id") @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  enrolledAt DateTime         @default(dbgenerated("CURRENT_DATE")) @map("enrolled_at") @db.Date
  leftAt     DateTime?        @map("left_at") @db.Date
  status     EnrollmentStatus @default(ACTIVE)
  note       String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  class       Class        @relation(fields: [classId], references: [id], map: "fk_class_students_class")
  student     Student      @relation(fields: [studentId], references: [id], map: "fk_class_students_student")
  tuitionFees TuitionFee[] @relation("TuitionFeeEnrollment")

  @@unique([classId, studentId], map: "uq_class_students_class_student")
  @@index([classId], map: "idx_class_students_class_id")
  @@index([studentId], map: "idx_class_students_student_id")
  @@map("class_students")
}

model ClassSchedule {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId     String  @map("class_id") @db.Uuid
  teacherId   String  @map("teacher_id") @db.Uuid
  dayOfWeek   Int     @map("day_of_week") @db.SmallInt
  startMinute Int     @map("start_minute")
  endMinute   Int     @map("end_minute")
  note        String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  class       Class        @relation(fields: [classId], references: [id], map: "fk_class_schedules_class")
  teacher     Teacher      @relation(fields: [teacherId], references: [id], map: "fk_class_schedules_teacher")
  attendances Attendance[]

  @@index([classId], map: "idx_class_schedules_class_id")
  @@index([teacherId, dayOfWeek], map: "idx_class_schedules_teacher_day")
  @@map("class_schedules")
}

model Attendance {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId        String           @map("class_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  scheduleId     String?          @map("schedule_id") @db.Uuid
  attendanceDate DateTime         @map("attendance_date") @db.Date
  status         AttendanceStatus @default(PRESENT)
  note           String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  class    Class          @relation(fields: [classId], references: [id], map: "fk_attendances_class")
  student  Student        @relation(fields: [studentId], references: [id], map: "fk_attendances_student")
  schedule ClassSchedule? @relation(fields: [scheduleId], references: [id], map: "fk_attendances_schedule")

  @@unique([classId, studentId, attendanceDate], map: "uq_attendances_class_student_date")
  @@index([classId, attendanceDate], map: "idx_attendances_class_date")
  @@index([studentId], map: "idx_attendances_student_id")
  @@map("attendances")
}

model Expense {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String        @unique(map: "uq_expenses_code") @db.VarChar(50)
  title       String        @db.VarChar(255)
  category    String?       @db.VarChar(100)
  amount      Decimal       @db.Decimal(12, 2)
  expenseDate DateTime      @map("expense_date") @db.Date
  status      ExpenseStatus @default(DRAFT)
  note        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([expenseDate], map: "idx_expenses_expense_date")
  @@index([status], map: "idx_expenses_status")
  @@map("expenses")
}

model ClassSalaryRule {
  id                     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId                String  @unique(map: "uq_class_salary_rules_class_id") @map("class_id") @db.Uuid
  teacherSharePercentage Decimal @default(0) @map("teacher_share_percentage") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  class Class @relation(fields: [classId], references: [id], map: "fk_class_salary_rules_class")

  @@map("class_salary_rules")
}

model TeacherPayroll {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId    String        @map("teacher_id") @db.Uuid
  billingYear  Int           @map("billing_year")
  billingMonth Int           @map("billing_month") @db.SmallInt
  totalRevenue Decimal       @default(0) @map("total_revenue") @db.Decimal(12, 2)
  centerFee    Decimal       @default(0) @map("center_fee") @db.Decimal(12, 2)
  salaryAmount Decimal       @default(0) @map("salary_amount") @db.Decimal(12, 2)
  status       PayrollStatus @default(DRAFT)
  approvedAt   DateTime?     @map("approved_at") @db.Timestamptz(6)
  paidAt       DateTime?     @map("paid_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher Teacher              @relation(fields: [teacherId], references: [id], map: "fk_teacher_payrolls_teacher")
  items   TeacherPayrollItem[]

  @@unique([teacherId, billingYear, billingMonth], map: "uq_teacher_payrolls_teacher_month")
  @@index([billingYear, billingMonth], map: "idx_teacher_payrolls_billing_month")
  @@index([status], map: "idx_teacher_payrolls_status")
  @@map("teacher_payrolls")
}

model TeacherPayrollItem {
  id                     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollId              String  @map("payroll_id") @db.Uuid
  classId                String  @map("class_id") @db.Uuid
  classCode              String  @map("class_code") @db.VarChar(50)
  className              String  @map("class_name") @db.VarChar(255)
  studentCount           Int     @default(0) @map("student_count")
  revenue                Decimal @default(0) @db.Decimal(12, 2)
  teacherSharePercentage Decimal @default(0) @map("teacher_share_percentage") @db.Decimal(5, 2)
  salary                 Decimal @default(0) @db.Decimal(12, 2)
  centerFee              Decimal @default(0) @map("center_fee") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payroll TeacherPayroll @relation(fields: [payrollId], references: [id], map: "fk_teacher_payroll_items_payroll")
  class   Class          @relation(fields: [classId], references: [id], map: "fk_teacher_payroll_items_class")

  @@unique([payrollId, classId], map: "uq_teacher_payroll_items_payroll_class")
  @@index([payrollId], map: "idx_teacher_payroll_items_payroll_id")
  @@index([classId], map: "idx_teacher_payroll_items_class_id")
  @@map("teacher_payroll_items")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  tableName String   @map("table_name") @db.VarChar(100)
  recordId  String?  @map("record_id") @db.Uuid
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  ipAddress String?  @map("ip_address") @db.Inet
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "idx_audit_logs_user_id")
  @@index([action], map: "idx_audit_logs_action")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@index([tableName, recordId], map: "idx_audit_logs_table_record")
  @@map("audit_logs")
}

// New one-time tuition/payment domain. These transitional tables are additive;
// legacy financial tables remain read-only until the migration report is approved.
model TuitionFee {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feeNo              String           @unique(map: "uq_tuition_fees_fee_no") @map("fee_no") @db.VarChar(30)
  studentId          String           @map("student_id") @db.Uuid
  enrollmentId       String           @map("enrollment_id") @db.Uuid
  classId            String           @map("class_id") @db.Uuid
  originalAmount     Decimal          @default(0) @map("original_amount") @db.Decimal(15, 2)
  discountAmount     Decimal          @default(0) @map("discount_amount") @db.Decimal(15, 2)
  additionalAmount   Decimal          @default(0) @map("additional_amount") @db.Decimal(15, 2)
  finalAmount        Decimal          @default(0) @map("final_amount") @db.Decimal(15, 2)
  dueDate            DateTime?        @map("due_date") @db.Date
  status             TuitionFeeStatus @default(UNPAID)
  exemptionReason    String?          @map("exemption_reason")
  cancellationReason String?          @map("cancellation_reason")
  note               String?
  version            Int              @default(1)
  createdBy          String           @map("created_by") @db.Uuid
  updatedBy          String           @map("updated_by") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  student     Student             @relation("TuitionFeeStudent", fields: [studentId], references: [id])
  enrollment  ClassStudent        @relation("TuitionFeeEnrollment", fields: [enrollmentId], references: [id])
  class       Class               @relation("TuitionFeeClass", fields: [classId], references: [id])
  items       TuitionFeeItem[]
  adjustments TuitionAdjustment[]
  payments    TuitionPayment[]
  paymentAllocations PaymentAllocation[]
  @@index([studentId], map: "idx_tuition_fees_student_id")
  @@index([classId], map: "idx_tuition_fees_class_id")
  @@index([status], map: "idx_tuition_fees_status")
  @@index([dueDate], map: "idx_tuition_fees_due_date")
  @@map("tuition_fees")
}

model TuitionFeeItem {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tuitionFeeId String             @map("tuition_fee_id") @db.Uuid
  itemType     TuitionFeeItemType @map("item_type")
  itemName     String             @map("item_name") @db.VarChar(255)
  quantity     Decimal            @default(1) @db.Decimal(10, 2)
  unitPrice    Decimal            @default(0) @map("unit_price") @db.Decimal(15, 2)
  amount       Decimal            @default(0) @db.Decimal(15, 2)
  displayOrder Int                @default(0) @map("display_order")
  note         String?
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tuitionFee TuitionFee @relation(fields: [tuitionFeeId], references: [id])

  @@index([tuitionFeeId], map: "idx_tuition_fee_items_fee_id")
  @@map("tuition_fee_items")
}

model TuitionAdjustment {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tuitionFeeId   String                @map("tuition_fee_id") @db.Uuid
  adjustmentType TuitionAdjustmentType @map("adjustment_type")
  amount         Decimal               @db.Decimal(15, 2)
  beforeAmount   Decimal               @map("before_amount") @db.Decimal(15, 2)
  afterAmount    Decimal               @map("after_amount") @db.Decimal(15, 2)
  reason         String
  approvedBy     String?               @map("approved_by") @db.Uuid
  createdBy      String                @map("created_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  tuitionFee TuitionFee @relation(fields: [tuitionFeeId], references: [id])

  @@index([tuitionFeeId], map: "idx_tuition_adjustments_fee_id")
  @@map("tuition_adjustments")
}

model TuitionPayment {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentNo            String               @unique(map: "uq_tuition_payments_payment_no") @map("payment_no") @db.VarChar(30)
  tuitionFeeId         String               @map("tuition_fee_id") @db.Uuid
  paymentBatchId       String?              @map("payment_batch_id") @db.Uuid
  studentId            String               @map("student_id") @db.Uuid
  paymentDate          DateTime             @default(now()) @map("payment_date") @db.Timestamptz(6)
  amount               Decimal              @db.Decimal(15, 2)
  paymentMethod        TuitionPaymentMethod @map("payment_method")
  paymentStatus        TuitionPaymentStatus @default(PENDING) @map("payment_status")
  idempotencyKey       String?              @unique(map: "uq_tuition_payments_idempotency_key") @map("idempotency_key") @db.VarChar(150)
  bankAccountId        String?              @map("bank_account_id") @db.Uuid
  bankTransactionNo    String?              @map("bank_transaction_no") @db.VarChar(150)
  transactionReference String?              @map("transaction_reference") @db.VarChar(150)
  payerName            String?              @map("payer_name") @db.VarChar(255)
  paymentContent       String?              @map("payment_content") @db.VarChar(500)
  proofFileUrl         String?              @map("proof_file_url")
  receivedBy           String?              @map("received_by") @db.Uuid
  confirmedBy          String?              @map("confirmed_by") @db.Uuid
  confirmedAt          DateTime?            @map("confirmed_at") @db.Timestamptz(6)
  failureReason        String?              @map("failure_reason")
  cancellationReason   String?              @map("cancellation_reason")
  note                 String?
  version              Int                  @default(1)
  createdBy            String               @map("created_by") @db.Uuid
  updatedBy            String               @map("updated_by") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tuitionFee TuitionFee      @relation(fields: [tuitionFeeId], references: [id])
  paymentBatch PaymentBatch? @relation(fields: [paymentBatchId], references: [id])
  receipt    TuitionReceipt?
  refunds    PaymentRefund[]

  @@index([tuitionFeeId], map: "idx_tuition_payments_fee_id")
  @@index([studentId], map: "idx_tuition_payments_student_id")
  @@index([paymentStatus], map: "idx_tuition_payments_status")
  @@map("tuition_payments")
}

model PaymentBatch {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchNo              String            @unique(map: "uq_payment_batches_batch_no") @map("batch_no") @db.VarChar(40)
  studentId            String            @map("student_id") @db.Uuid
  totalAmount          Decimal           @map("total_amount") @db.Decimal(15, 2)
  paymentMethod        TuitionPaymentMethod @map("payment_method")
  status               PaymentBatchStatus @default(PENDING)
  paymentDate          DateTime          @default(now()) @map("payment_date") @db.Timestamptz(6)
  bankAccountId        String?           @map("bank_account_id") @db.Uuid
  bankTransactionNo    String?           @map("bank_transaction_no") @db.VarChar(150)
  transactionReference String?           @map("transaction_reference") @db.VarChar(150)
  payerName            String?           @map("payer_name") @db.VarChar(255)
  paymentContent       String?           @map("payment_content") @db.VarChar(500)
  confirmedBy          String?           @map("confirmed_by") @db.Uuid
  confirmedAt          DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  createdBy            String            @map("created_by") @db.Uuid
  updatedBy            String            @map("updated_by") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  student       Student                    @relation(fields: [studentId], references: [id])
  bankAccount   BankAccount?               @relation(fields: [bankAccountId], references: [id])
  allocations   PaymentAllocation[]
  payments      TuitionPayment[]
  transactions  BankStatementTransaction[]
  receipt       PaymentBatchReceipt?

  @@index([studentId], map: "idx_payment_batches_student_id")
  @@index([status], map: "idx_payment_batches_status")
  @@map("payment_batches")
}

model PaymentAllocation {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentBatchId String      @map("payment_batch_id") @db.Uuid
  tuitionFeeId   String      @map("tuition_fee_id") @db.Uuid
  amount         Decimal     @db.Decimal(15, 2)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  paymentBatch PaymentBatch @relation(fields: [paymentBatchId], references: [id])
  tuitionFee   TuitionFee   @relation(fields: [tuitionFeeId], references: [id])

  @@unique([paymentBatchId, tuitionFeeId], map: "uq_payment_allocations_batch_fee")
  @@index([tuitionFeeId], map: "idx_payment_allocations_fee_id")
  @@map("payment_allocations")
}

model PaymentBatchReceipt {
