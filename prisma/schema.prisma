generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED

  @@map("user_status")
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE

  @@map("teacher_status")
}

enum StudentStatus {
  ACTIVE
  INACTIVE

  @@map("student_status")
}

enum ClassStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("class_status")
}

enum SubjectStatus {
  ACTIVE
  INACTIVE

  @@map("subject_status")
}

enum ClassSubjectStatus {
  ACTIVE
  INACTIVE

  @@map("class_subject_status")
}

enum EnrollmentSubjectStatus {
  ACTIVE
  DROPPED
  COMPLETED

  @@map("enrollment_subject_status")
}

enum EnrollmentStatus {
  ACTIVE
  LEFT
  COMPLETED
  SUSPENDED

  @@map("enrollment_status")
}

enum ReceiptStatus {
  ACTIVE
  CANCELLED

  @@map("receipt_status")
}

enum TuitionFeeStatus {
  UNPAID
  PAID
  OVERDUE
  EXEMPTED
  CANCELLED

  @@map("tuition_fee_status")
}

enum TuitionFeeItemType {
  TUITION
  MATERIAL
  UNIFORM
  EXAM_FEE
  OTHER_FEE
  DISCOUNT
  SCHOLARSHIP

  @@map("tuition_fee_item_type")
}

enum TuitionPaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER

  @@map("tuition_payment_method")
}

enum TuitionPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED

  @@map("tuition_payment_status")
}

enum PaymentBatchStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED

  @@map("payment_batch_status")
}

enum BankImportStatus {
  UPLOADED
  VALIDATING
  VALIDATED
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED

  @@map("bank_import_status")
}

enum BankReconciliationStatus {
  IMPORTED
  AUTO_MATCHED
  MANUAL_MATCHED
  CONFIRMED
  UNMATCHED
  AMBIGUOUS
  DUPLICATED
  AMOUNT_MISMATCH
  IGNORED
  REVERSED
  ERROR

  @@map("bank_reconciliation_status")
}

enum BankMatchMethod {
  TUITION_FEE_NO
  STUDENT_CODE
  PAYMENT_REFERENCE
  PHONE_NUMBER
  STUDENT_NAME
  PARENT_NAME
  AMOUNT
  MANUAL

  @@map("bank_match_method")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique(map: "uq_users_email") @db.VarChar(255)
  fullName     String     @map("full_name") @db.VarChar(255)
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  roles   UserRole[]
  teacher Teacher?

  @@map("users")
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique(map: "uq_roles_code") @db.VarChar(50)
  name        String  @db.VarChar(255)
  description String?
  isActive    Boolean @default(true) @map("is_active")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], map: "fk_user_roles_user")
  role Role @relation(fields: [roleId], references: [id], map: "fk_user_roles_role")

  @@unique([userId, roleId], map: "uq_user_roles_user_role")
  @@map("user_roles")
}

model Teacher {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String        @unique(map: "uq_teachers_code") @db.VarChar(50)
  userId      String?       @unique(map: "uq_teachers_user_id") @map("user_id") @db.Uuid
  fullName    String        @map("full_name") @db.VarChar(255)
  phone       String?       @db.VarChar(50)
  bankAccount String?       @map("bank_account") @db.VarChar(100)
  specialty   String?       @db.VarChar(255)
  status      TeacherStatus @default(ACTIVE)
  note        String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user      User?           @relation(fields: [userId], references: [id], map: "fk_teachers_user")
  classSubjects ClassSubject[]
  schedules ClassSchedule[]

  @@map("teachers")
}

model Student {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String        @unique(map: "uq_students_code") @db.VarChar(50)
  fullName   String        @map("full_name") @db.VarChar(255)
  phone      String?       @db.VarChar(50)
  birthday   DateTime?     @db.Date
  parentName String?       @map("parent_name") @db.VarChar(255)
  address    String?
  status     StudentStatus @default(ACTIVE)
  note       String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  enrollments    ClassStudent[]
  tuitionFees    TuitionFee[]   @relation("TuitionFeeStudent")
  paymentBatches PaymentBatch[]

  @@map("students")
}

model Subject {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String        @unique(map: "uq_subjects_code") @db.VarChar(50)
  name      String        @db.VarChar(255)
  status    SubjectStatus  @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)

  classSubjects ClassSubject[]

  @@index([status], map: "idx_subjects_status")
  @@map("subjects")
}

model Class {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String      @unique(map: "uq_classes_code") @db.VarChar(50)
  name          String      @db.VarChar(255)
  startDate     DateTime?   @map("start_date") @db.Date
  endDate       DateTime?   @map("end_date") @db.Date
  status        ClassStatus @default(DRAFT)
  note          String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  students    ClassStudent[]
  classSubjects ClassSubject[]
  schedules   ClassSchedule[]
  tuitionFees TuitionFee[]    @relation("TuitionFeeClass")

  @@index([status], map: "idx_classes_status")
  @@map("classes")
}

model ClassStudent {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId    String           @map("class_id") @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  enrolledAt DateTime         @default(dbgenerated("CURRENT_DATE")) @map("enrolled_at") @db.Date
  leftAt     DateTime?        @map("left_at") @db.Date
  status     EnrollmentStatus @default(ACTIVE)
  note       String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  class       Class        @relation(fields: [classId], references: [id], map: "fk_class_students_class")
  student     Student      @relation(fields: [studentId], references: [id], map: "fk_class_students_student")
  tuitionFees TuitionFee[] @relation("TuitionFeeEnrollment")
  subjects    EnrollmentSubject[]

  @@unique([classId, studentId], map: "uq_class_students_class_student")
  @@index([classId], map: "idx_class_students_class_id")
  @@index([studentId], map: "idx_class_students_student_id")
  @@map("class_students")
}

model ClassSubject {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId       String             @map("class_id") @db.Uuid
  subjectId     String             @map("subject_id") @db.Uuid
  teacherId     String?            @map("teacher_id") @db.Uuid
  tuitionFee    Decimal            @default(0) @map("tuition_fee") @db.Decimal(15, 2)
  totalSessions Int                @default(0) @map("total_sessions")
  maxStudents   Int?               @map("max_students")
  status        ClassSubjectStatus @default(ACTIVE)
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?          @map("deleted_at") @db.Timestamptz(6)

  class         Class              @relation(fields: [classId], references: [id], map: "fk_class_subjects_class")
  subject       Subject            @relation(fields: [subjectId], references: [id], map: "fk_class_subjects_subject")
  teacher       Teacher?           @relation(fields: [teacherId], references: [id], map: "fk_class_subjects_teacher")
  enrollments   EnrollmentSubject[]
  schedules     ClassSchedule[]
  tuitionItems  TuitionFeeItem[]

  @@unique([classId, subjectId], map: "uq_class_subjects_class_subject")
  @@index([classId], map: "idx_class_subjects_class_id")
  @@index([subjectId], map: "idx_class_subjects_subject_id")
  @@index([teacherId], map: "idx_class_subjects_teacher_id")
  @@map("class_subjects")
}

model EnrollmentSubject {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId        String                  @map("enrollment_id") @db.Uuid
  classSubjectId      String                  @map("class_subject_id") @db.Uuid
  tuitionFeeOverride  Decimal?                @map("tuition_fee_override") @db.Decimal(15, 2)
  status              EnrollmentSubjectStatus @default(ACTIVE)
  enrolledAt          DateTime                @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  droppedAt           DateTime?               @map("dropped_at") @db.Timestamptz(6)
  note                String?

  enrollment   ClassStudent @relation(fields: [enrollmentId], references: [id], map: "fk_enrollment_subjects_enrollment")
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], map: "fk_enrollment_subjects_class_subject")

  @@unique([enrollmentId, classSubjectId], map: "uq_enrollment_subjects_enrollment_subject")
  @@index([enrollmentId], map: "idx_enrollment_subjects_enrollment_id")
  @@index([classSubjectId], map: "idx_enrollment_subjects_class_subject_id")
  @@map("enrollment_subjects")
}

model ClassSchedule {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId     String  @map("class_id") @db.Uuid
  classSubjectId String? @map("class_subject_id") @db.Uuid
  teacherId   String  @map("teacher_id") @db.Uuid
  dayOfWeek   Int     @map("day_of_week") @db.SmallInt
  startMinute Int     @map("start_minute")
  endMinute   Int     @map("end_minute")
  note        String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  class       Class        @relation(fields: [classId], references: [id], map: "fk_class_schedules_class")
  classSubject ClassSubject? @relation(fields: [classSubjectId], references: [id], map: "fk_class_schedules_class_subject")
  teacher     Teacher      @relation(fields: [teacherId], references: [id], map: "fk_class_schedules_teacher")
  @@index([classId], map: "idx_class_schedules_class_id")
  @@index([classSubjectId], map: "idx_class_schedules_class_subject_id")
  @@index([teacherId, dayOfWeek], map: "idx_class_schedules_teacher_day")
  @@map("class_schedules")
}

// New one-time tuition/payment domain. These transitional tables are additive;
// legacy financial tables remain read-only until the migration report is approved.
model TuitionFee {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feeNo              String           @unique(map: "uq_tuition_fees_fee_no") @map("fee_no") @db.VarChar(30)
  studentId          String           @map("student_id") @db.Uuid
  enrollmentId       String           @map("enrollment_id") @db.Uuid
  classId            String           @map("class_id") @db.Uuid
  originalAmount     Decimal          @default(0) @map("original_amount") @db.Decimal(15, 2)
  discountAmount     Decimal          @default(0) @map("discount_amount") @db.Decimal(15, 2)
  additionalAmount   Decimal          @default(0) @map("additional_amount") @db.Decimal(15, 2)
  finalAmount        Decimal          @default(0) @map("final_amount") @db.Decimal(15, 2)
  dueDate            DateTime?        @map("due_date") @db.Date
  status             TuitionFeeStatus @default(UNPAID)
  exemptionReason    String?          @map("exemption_reason")
  cancellationReason String?          @map("cancellation_reason")
  note               String?
  version            Int              @default(1)
  createdBy          String           @map("created_by") @db.Uuid
  updatedBy          String           @map("updated_by") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  student            Student             @relation("TuitionFeeStudent", fields: [studentId], references: [id])
  enrollment         ClassStudent        @relation("TuitionFeeEnrollment", fields: [enrollmentId], references: [id])
  class              Class               @relation("TuitionFeeClass", fields: [classId], references: [id])
  items              TuitionFeeItem[]
  payments           TuitionPayment[]
  paymentAllocations PaymentAllocation[]

  @@index([studentId], map: "idx_tuition_fees_student_id")
  @@index([classId], map: "idx_tuition_fees_class_id")
  @@index([status], map: "idx_tuition_fees_status")
  @@index([dueDate], map: "idx_tuition_fees_due_date")
  @@map("tuition_fees")
}

model TuitionFeeItem {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tuitionFeeId String             @map("tuition_fee_id") @db.Uuid
  classSubjectId String?          @map("class_subject_id") @db.Uuid
  itemType     TuitionFeeItemType @map("item_type")
  itemName     String             @map("item_name") @db.VarChar(255)
  quantity     Decimal            @default(1) @db.Decimal(10, 2)
  unitPrice    Decimal            @default(0) @map("unit_price") @db.Decimal(15, 2)
  amount       Decimal            @default(0) @db.Decimal(15, 2)
  displayOrder Int                @default(0) @map("display_order")
  note         String?
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tuitionFee TuitionFee @relation(fields: [tuitionFeeId], references: [id])
  classSubject ClassSubject? @relation(fields: [classSubjectId], references: [id], map: "fk_tuition_fee_items_class_subject")

  @@index([tuitionFeeId], map: "idx_tuition_fee_items_fee_id")
  @@index([classSubjectId], map: "idx_tuition_fee_items_class_subject_id")
  @@map("tuition_fee_items")
}

model TuitionPayment {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentNo            String               @unique(map: "uq_tuition_payments_payment_no") @map("payment_no") @db.VarChar(30)
  tuitionFeeId         String               @map("tuition_fee_id") @db.Uuid
  paymentBatchId       String?              @map("payment_batch_id") @db.Uuid
  studentId            String               @map("student_id") @db.Uuid
  paymentDate          DateTime             @default(now()) @map("payment_date") @db.Timestamptz(6)
  amount               Decimal              @db.Decimal(15, 2)
  paymentMethod        TuitionPaymentMethod @map("payment_method")
  paymentStatus        TuitionPaymentStatus @default(PENDING) @map("payment_status")
  idempotencyKey       String?              @unique(map: "uq_tuition_payments_idempotency_key") @map("idempotency_key") @db.VarChar(150)
  bankAccountId        String?              @map("bank_account_id") @db.Uuid
  bankTransactionNo    String?              @map("bank_transaction_no") @db.VarChar(150)
  transactionReference String?              @map("transaction_reference") @db.VarChar(150)
  payerName            String?              @map("payer_name") @db.VarChar(255)
  paymentContent       String?              @map("payment_content") @db.VarChar(500)
  proofFileUrl         String?              @map("proof_file_url")
  receivedBy           String?              @map("received_by") @db.Uuid
  confirmedBy          String?              @map("confirmed_by") @db.Uuid
  confirmedAt          DateTime?            @map("confirmed_at") @db.Timestamptz(6)
  failureReason        String?              @map("failure_reason")
  cancellationReason   String?              @map("cancellation_reason")
  note                 String?
  version              Int                  @default(1)
  createdBy            String               @map("created_by") @db.Uuid
  updatedBy            String               @map("updated_by") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tuitionFee   TuitionFee      @relation(fields: [tuitionFeeId], references: [id])
  paymentBatch PaymentBatch?   @relation(fields: [paymentBatchId], references: [id])
  receipt      TuitionReceipt?

  @@index([tuitionFeeId], map: "idx_tuition_payments_fee_id")
  @@index([studentId], map: "idx_tuition_payments_student_id")
  @@index([paymentStatus], map: "idx_tuition_payments_status")
  @@map("tuition_payments")
}

model PaymentBatch {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchNo              String               @unique(map: "uq_payment_batches_batch_no") @map("batch_no") @db.VarChar(40)
  studentId            String               @map("student_id") @db.Uuid
  totalAmount          Decimal              @map("total_amount") @db.Decimal(15, 2)
  paymentMethod        TuitionPaymentMethod @map("payment_method")
  status               PaymentBatchStatus   @default(PENDING)
  paymentDate          DateTime             @default(now()) @map("payment_date") @db.Timestamptz(6)
  bankAccountId        String?              @map("bank_account_id") @db.Uuid
  bankTransactionNo    String?              @map("bank_transaction_no") @db.VarChar(150)
  transactionReference String?              @map("transaction_reference") @db.VarChar(150)
  payerName            String?              @map("payer_name") @db.VarChar(255)
  paymentContent       String?              @map("payment_content") @db.VarChar(500)
  confirmedBy          String?              @map("confirmed_by") @db.Uuid
  confirmedAt          DateTime?            @map("confirmed_at") @db.Timestamptz(6)
  createdBy            String               @map("created_by") @db.Uuid
  updatedBy            String               @map("updated_by") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  student      Student                    @relation(fields: [studentId], references: [id])
  bankAccount  BankAccount?               @relation(fields: [bankAccountId], references: [id])
  allocations  PaymentAllocation[]
  payments     TuitionPayment[]
  transactions BankStatementTransaction[]
  receipt      PaymentBatchReceipt?

  @@index([studentId], map: "idx_payment_batches_student_id")
  @@index([status], map: "idx_payment_batches_status")
  @@map("payment_batches")
}

model PaymentAllocation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentBatchId String   @map("payment_batch_id") @db.Uuid
  tuitionFeeId   String   @map("tuition_fee_id") @db.Uuid
  amount         Decimal  @db.Decimal(15, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  paymentBatch PaymentBatch @relation(fields: [paymentBatchId], references: [id])
  tuitionFee   TuitionFee   @relation(fields: [tuitionFeeId], references: [id])

  @@unique([paymentBatchId, tuitionFeeId], map: "uq_payment_allocations_batch_fee")
  @@index([tuitionFeeId], map: "idx_payment_allocations_fee_id")
  @@map("payment_allocations")
}

model PaymentBatchReceipt {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptNo      String       @unique(map: "uq_payment_batch_receipts_receipt_no") @map("receipt_no") @db.VarChar(40)
  paymentBatchId String       @unique(map: "uq_payment_batch_receipts_batch_id") @map("payment_batch_id") @db.Uuid
  issuedAt       DateTime     @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedBy       String       @map("issued_by") @db.Uuid
  receiverName   String?      @map("receiver_name") @db.VarChar(255)
  amount         Decimal      @db.Decimal(15, 2)
  paymentBatch   PaymentBatch @relation(fields: [paymentBatchId], references: [id])

  @@map("payment_batch_receipts")
}

model TuitionReceipt {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptNo          String        @unique(map: "uq_tuition_receipts_receipt_no") @map("receipt_no") @db.VarChar(30)
  paymentId          String        @unique(map: "uq_tuition_receipts_payment_id") @map("payment_id") @db.Uuid
  issuedAt           DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedBy           String        @map("issued_by") @db.Uuid
  receiverName       String?       @map("receiver_name") @db.VarChar(255)
  amount             Decimal       @db.Decimal(15, 2)
  amountInWords      String?       @map("amount_in_words")
  pdfFileUrl         String?       @map("pdf_file_url")
  emailSentAt        DateTime?     @map("email_sent_at") @db.Timestamptz(6)
  status             ReceiptStatus @default(ACTIVE)
  cancellationReason String?       @map("cancellation_reason")
  cancelledBy        String?       @map("cancelled_by") @db.Uuid
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  payment TuitionPayment @relation(fields: [paymentId], references: [id])

  @@map("tuition_receipts")
}

model BankAccount {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankCode     String   @map("bank_code") @db.VarChar(50)
  bankName     String   @map("bank_name") @db.VarChar(255)
  accountNo    String   @map("account_no") @db.VarChar(100)
  accountName  String   @map("account_name") @db.VarChar(255)
  branchName   String?  @map("branch_name") @db.VarChar(255)
  currencyCode String   @default("VND") @map("currency_code") @db.VarChar(10)
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    String   @map("created_by") @db.Uuid
  updatedBy    String   @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  imports        BankStatementImport[]
  paymentBatches PaymentBatch[]

  @@unique([bankCode, accountNo], map: "uq_bank_accounts_bank_account")
  @@map("bank_accounts")
}

model BankStatementImport {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankAccountId  String           @map("bank_account_id") @db.Uuid
  fileName       String           @map("file_name") @db.VarChar(255)
  fileUrl        String           @map("file_url")
  fileHash       String           @map("file_hash") @db.VarChar(128)
  encoding       String           @db.VarChar(50)
  delimiter      String           @db.VarChar(5)
  dateFormat     String           @map("date_format") @db.VarChar(50)
  totalRows      Int              @default(0) @map("total_rows")
  validRows      Int              @default(0) @map("valid_rows")
  invalidRows    Int              @default(0) @map("invalid_rows")
  duplicatedRows Int              @default(0) @map("duplicated_rows")
  matchedRows    Int              @default(0) @map("matched_rows")
  unmatchedRows  Int              @default(0) @map("unmatched_rows")
  importStatus   BankImportStatus @default(UPLOADED) @map("import_status")
  errorMessage   String?          @map("error_message")
  importedBy     String           @map("imported_by") @db.Uuid
  importedAt     DateTime         @default(now()) @map("imported_at") @db.Timestamptz(6)
  confirmedBy    String?          @map("confirmed_by") @db.Uuid
  confirmedAt    DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  bankAccount  BankAccount                @relation(fields: [bankAccountId], references: [id])
  transactions BankStatementTransaction[]

  @@unique([bankAccountId, fileHash], map: "uq_bank_statement_imports_file")
  @@map("bank_statement_imports")
}

model BankStatementTransaction {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  statementImportId    String                   @map("statement_import_id") @db.Uuid
  bankAccountId        String                   @map("bank_account_id") @db.Uuid
  rowNo                Int                      @map("row_no")
  bankTransactionNo    String?                  @map("bank_transaction_no") @db.VarChar(255)
  transactionDate      DateTime                 @map("transaction_date") @db.Timestamptz(6)
  valueDate            DateTime?                @map("value_date") @db.Timestamptz(6)
  description          String?
  senderName           String?                  @map("sender_name") @db.VarChar(255)
  senderAccountNo      String?                  @map("sender_account_no") @db.VarChar(100)
  senderBankCode       String?                  @map("sender_bank_code") @db.VarChar(50)
  creditAmount         Decimal                  @default(0) @map("credit_amount") @db.Decimal(15, 2)
  debitAmount          Decimal                  @default(0) @map("debit_amount") @db.Decimal(15, 2)
  balanceAmount        Decimal?                 @map("balance_amount") @db.Decimal(15, 2)
  currencyCode         String                   @default("VND") @map("currency_code") @db.VarChar(10)
  transactionHash      String                   @map("transaction_hash") @db.VarChar(128)
  reconciliationStatus BankReconciliationStatus @default(IMPORTED) @map("reconciliation_status")
  matchScore           Decimal?                 @map("match_score") @db.Decimal(5, 2)
  matchMethod          BankMatchMethod?         @map("match_method")
  matchedStudentId     String?                  @map("matched_student_id") @db.Uuid
  matchedTuitionFeeId  String?                  @map("matched_tuition_fee_id") @db.Uuid
  matchedNoticeId      String?                  @map("matched_notice_id") @db.Uuid
  paymentId            String?                  @map("payment_id") @db.Uuid
  paymentBatchId       String?                  @map("payment_batch_id") @db.Uuid
  errorCode            String?                  @map("error_code") @db.VarChar(100)
  errorMessage         String?                  @map("error_message")
  confirmedBy          String?                  @map("confirmed_by") @db.Uuid
  confirmedAt          DateTime?                @map("confirmed_at") @db.Timestamptz(6)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  statementImport BankStatementImport           @relation(fields: [statementImportId], references: [id])
  paymentBatch    PaymentBatch?                 @relation(fields: [paymentBatchId], references: [id])
  candidates      BankStatementMatchCandidate[]

  @@unique([bankAccountId, transactionHash], map: "uq_bank_statement_transactions_hash")
  @@index([transactionDate], map: "idx_bank_statement_transactions_date")
  @@index([reconciliationStatus], map: "idx_bank_statement_transactions_status")
  @@map("bank_statement_transactions")
}

model BankStatementMatchCandidate {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  statementTransactionId String          @map("statement_transaction_id") @db.Uuid
  studentId              String          @map("student_id") @db.Uuid
  tuitionFeeId           String          @map("tuition_fee_id") @db.Uuid
  matchMethod            BankMatchMethod @map("match_method")
  matchScore             Decimal         @map("match_score") @db.Decimal(5, 2)
  matchedReference       String?         @map("matched_reference") @db.VarChar(255)
  amountDifference       Decimal         @default(0) @map("amount_difference") @db.Decimal(15, 2)
  isSelected             Boolean         @default(false) @map("is_selected")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  statementTransaction BankStatementTransaction @relation(fields: [statementTransactionId], references: [id])

  @@index([statementTransactionId], map: "idx_bank_match_candidates_transaction_id")
  @@map("bank_statement_match_candidates")
}

model TuitionAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String   @map("entity_id") @db.Uuid
  action      String   @db.VarChar(100)
  dataBefore  Json?    @map("data_before")
  dataAfter   Json?    @map("data_after")
  reason      String?
  performedBy String   @map("performed_by") @db.Uuid
  performedAt DateTime @default(now()) @map("performed_at") @db.Timestamptz(6)
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")

  @@index([entityType, entityId], map: "idx_tuition_audit_entity")
  @@index([action], map: "idx_tuition_audit_action")
  @@map("tuition_audit_logs")
}
